{
    "name": "zcwilt/forumkit-forums",
    "description": "Forums for ForumKit: forum groups, forums, threads and posts, visibility and posting rules, and moderation, as a Filament plugin.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "filament",
        "filament-plugin",
        "forum"
    ],
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.0",
        "zcwilt/forumkit-core": "^0.1.3",
        "zcwilt/forumkit-entitlements": "^0.1"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "ForumKit\\Forums\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ForumKit\\Forums\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G"
    },
    "extra": {
        "laravel": {
            "providers": [
                "ForumKit\\Forums\\ForumsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
